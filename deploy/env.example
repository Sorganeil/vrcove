# /etc/vrcove/env (chmod 600). An https origin turns on tunnel-only mode.
PUBLIC_ORIGIN=https://vrcove.example
SESSION_KEY=
VRC_CONTACT=operator@example.com
# Enables VRCove accounts and reviews: openssl rand -base64 32. Keep the same key.
# A new key makes existing VRChat links unreadable (accounts and reviews survive).
ACCOUNT_KEY=
# For Cloudflare Turnstile on registration, set both values or leave both empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Desktop logger submissions, checked with a VRChat account the operator owns.
# Requires ACCOUNT_KEY and VRC_CONTACT. An owner signs the bot in from the
# moderation panel under Backend account. To sign in from the server instead,
# set BOT_USERNAME and BOT_PASSWORD and run `vrcove bot-login` once.
LOGGER_ENABLED=false
BOT_USERNAME=
BOT_PASSWORD=
