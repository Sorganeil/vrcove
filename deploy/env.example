# /etc/vrcove/env (chmod 600). An https origin turns on tunnel-only mode.
PUBLIC_ORIGIN=https://vrcove.example
SESSION_KEY=
VRC_CONTACT=operator@example.com
# Enables VRCove accounts and reviews: openssl rand -base64 32. Keep it stable;
# a new key makes existing VRChat links unreadable (accounts and reviews survive).
ACCOUNT_KEY=
