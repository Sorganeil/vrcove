# Set production values in /etc/vrcove/env. Never commit keys.
SESSION_KEY=
ACCOUNT_KEY=
VRC_CONTACT=operator@example.com
# For Cloudflare Turnstile on registration, set both values or leave both empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Enable user-generated, session-bound desktop companion API keys.
# Requires ACCOUNT_KEY, SESSION_KEY and VRC_CONTACT. No shared VRChat account is used.
LOGGER_ENABLED=false
