# Set production values in /etc/vrcove/env. Never commit keys.
SESSION_KEY=
ACCOUNT_KEY=
VRC_CONTACT=operator@example.com
# For Cloudflare Turnstile on registration, set both values or leave both empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Accept desktop logger submissions, checked with a VRChat account the operator
# owns. Requires ACCOUNT_KEY and VRC_CONTACT. An owner signs that account in from
# the moderation panel under Backend account. To sign in from the server instead,
# set BOT_USERNAME and BOT_PASSWORD and run `vrcove bot-login` once.
LOGGER_ENABLED=false
BOT_USERNAME=
BOT_PASSWORD=
