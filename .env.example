# Configure production values in /etc/vrcove/env; never commit keys.
SESSION_KEY=
ACCOUNT_KEY=
VRC_CONTACT=operator@example.com
# Optional Cloudflare Turnstile on registration; set both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Enable user-generated, session-bound desktop companion API keys.
# Requires ACCOUNT_KEY, SESSION_KEY and VRC_CONTACT; no shared VRChat account.
LOGGER_ENABLED=false
