# Set production values in /etc/vrcove/env. Never commit keys.
SESSION_KEY=
ACCOUNT_KEY=
VRC_CONTACT=operator@example.com
# For Cloudflare Turnstile on registration, set both values or leave both empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Accept desktop logger submissions, checked with a VRChat account the operator
# owns. Requires ACCOUNT_KEY and VRC_CONTACT. Then run `vrcove bot-login` once
# with this environment to enter the code VRChat sends to the bot account.
LOGGER_ENABLED=false
BOT_USERNAME=
BOT_PASSWORD=
# Website VRChat requests from the browser's VRChat worker, so this server only
# relays encrypted bytes. "on": new connections use the worker. "only": the
# cutover, after which the server refuses its own VRChat routes.
VRCHAT_WORKER=
